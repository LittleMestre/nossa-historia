# Necessárias somente a partir da Etapa 2B, quando o frontend usar Supabase.
# Para desenvolvimento local, obtenha URL e chave publicável via `npx supabase status`.
# Não copie valores reais para este arquivo versionado.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_APP_ORIGIN=http://127.0.0.1:3000
# Nunca usar service_role no navegador. Variáveis privilegiadas só no servidor.
SUPABASE_SECRET_KEY=
# Permita /convite** nas Redirect URLs do Supabase Auth.
# Google OAuth local: configure valores reais somente no .env ignorado pelo Git.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
